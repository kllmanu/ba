<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions_Lena" targetNamespace="https://fhv.at/lena/bpmn">
    <bpmn:process id="Process_Lena" name="Prüfungsfragen mit LLM erstellen" isExecutable="false">
        <bpmn:laneSet id="LaneSet_Lena">
            <bpmn:lane id="Lane_Teachers" name="Lehrende">
                <bpmn:flowNodeRef>StartEvent_Start</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_Source</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>UserTask_ManualCreate</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>UserTask_Review</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_Suitable</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_Revise</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>UserTask_ManualEdit</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>UserTask_AddSelection</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_MoreQuestions</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>UserTask_Assemble</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Scripts" name="Skripte">
                <bpmn:flowNodeRef>Gateway_Created</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ServiceTask_Export</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_End</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_LLM" name="LLM">
                <bpmn:flowNodeRef>ServiceTask_LLMCreate</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>ServiceTask_LLMRevise</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>

        <bpmn:startEvent id="StartEvent_Start" name="Start" />
        <bpmn:exclusiveGateway id="Gateway_Source" name="Erstellungsart?"
            gatewayDirection="Diverging" />
        <bpmn:userTask id="UserTask_ManualCreate" name="Frage manuell erfassen" />
        <bpmn:serviceTask id="ServiceTask_LLMCreate" name="Frage(n) generieren" />
        <bpmn:exclusiveGateway id="Gateway_Created" name="Daten bereit"
            gatewayDirection="Converging" />
        <bpmn:userTask id="UserTask_Review" name="Frage prüfen" />
        <bpmn:exclusiveGateway id="Gateway_Suitable" name="Geeignet?" gatewayDirection="Diverging" />
        <bpmn:exclusiveGateway id="Gateway_Revise" name="Nächster Schritt?"
            gatewayDirection="Diverging" />
        <bpmn:userTask id="UserTask_ManualEdit" name="Bearbeiten" />
        <bpmn:serviceTask id="ServiceTask_LLMRevise" name="Verfeinern (Branching)" />
        <bpmn:userTask id="UserTask_AddSelection" name="Zum Fragenpool hinzufügen" />
        <bpmn:exclusiveGateway id="Gateway_MoreQuestions" name="Auswahl vollständig?"
            gatewayDirection="Diverging" />
        <bpmn:userTask id="UserTask_Assemble" name="Prüfung zusammenstellen" />
        <bpmn:serviceTask id="ServiceTask_Export" name="QTI exportieren" />
        <bpmn:endEvent id="EndEvent_End" name="Prüfung exportiert" />

        <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Start" targetRef="Gateway_Source" />
        <bpmn:sequenceFlow id="Flow_02" sourceRef="Gateway_Source"
            targetRef="UserTask_ManualCreate" />
        <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_Source"
            targetRef="ServiceTask_LLMCreate" />
        <bpmn:sequenceFlow id="Flow_04" sourceRef="UserTask_ManualCreate"
            targetRef="Gateway_Created" />
        <bpmn:sequenceFlow id="Flow_05" sourceRef="ServiceTask_LLMCreate"
            targetRef="Gateway_Created" />
        <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_Created" targetRef="UserTask_Review" />
        <bpmn:sequenceFlow id="Flow_10" sourceRef="UserTask_Review" targetRef="Gateway_Suitable" />
        <bpmn:sequenceFlow id="Flow_11" name="ja" sourceRef="Gateway_Suitable"
            targetRef="UserTask_AddSelection" />
        <bpmn:sequenceFlow id="Flow_12" name="nein" sourceRef="Gateway_Suitable"
            targetRef="Gateway_Revise" />
        <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_Revise"
            targetRef="UserTask_ManualEdit" />
        <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Revise"
            targetRef="ServiceTask_LLMRevise" />
        <bpmn:sequenceFlow id="Flow_15" name="verwerfen" sourceRef="Gateway_Revise"
            targetRef="Gateway_Source" />
        <bpmn:sequenceFlow id="Flow_16" sourceRef="UserTask_ManualEdit" targetRef="Gateway_Created" />
        <bpmn:sequenceFlow id="Flow_17" sourceRef="ServiceTask_LLMRevise"
            targetRef="Gateway_Created" />
        <bpmn:sequenceFlow id="Flow_18" sourceRef="UserTask_AddSelection"
            targetRef="Gateway_MoreQuestions" />
        <bpmn:sequenceFlow id="Flow_19" name="ja" sourceRef="Gateway_MoreQuestions"
            targetRef="Gateway_Source" />
        <bpmn:sequenceFlow id="Flow_20" name="nein" sourceRef="Gateway_MoreQuestions"
            targetRef="UserTask_Assemble" />
        <bpmn:sequenceFlow id="Flow_21" sourceRef="UserTask_Assemble" targetRef="ServiceTask_Export" />
        <bpmn:sequenceFlow id="Flow_22" sourceRef="ServiceTask_Export" targetRef="EndEvent_End" />
    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_Lena">
        <bpmndi:BPMNPlane id="BPMNPlane_Lena" bpmnElement="Process_Lena">
            <bpmndi:BPMNShape id="Shape_Lane_Teachers" bpmnElement="Lane_Teachers"
                isHorizontal="true">
                <dc:Bounds x="30" y="30" width="1740" height="330" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Lane_Scripts" bpmnElement="Lane_Scripts" isHorizontal="true">
                <dc:Bounds x="30" y="360" width="1740" height="200" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Lane_LLM" bpmnElement="Lane_LLM" isHorizontal="true">
                <dc:Bounds x="30" y="560" width="1740" height="240" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_Start">
                <dc:Bounds x="135" y="172" width="36" height="36" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Source" bpmnElement="Gateway_Source" isMarkerVisible="true">
                <dc:Bounds x="205" y="165" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_ManualCreate" bpmnElement="UserTask_ManualCreate">
                <dc:Bounds x="295" y="150" width="140" height="80" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_LLMCreate" bpmnElement="ServiceTask_LLMCreate">
                <dc:Bounds x="295" y="620" width="150" height="80" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Created" bpmnElement="Gateway_Created"
                isMarkerVisible="true">
                <dc:Bounds x="460" y="410" width="50" height="50" />
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="390" y="372" width="150" height="24" />
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Review" bpmnElement="UserTask_Review">
                <dc:Bounds x="545" y="150" width="145" height="80" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Suitable" bpmnElement="Gateway_Suitable"
                isMarkerVisible="true">
                <dc:Bounds x="710" y="165" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Revise" bpmnElement="Gateway_Revise" isMarkerVisible="true">
                <dc:Bounds x="710" y="275" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_ManualEdit" bpmnElement="UserTask_ManualEdit">
                <dc:Bounds x="825" y="265" width="150" height="70" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_LLMRevise" bpmnElement="ServiceTask_LLMRevise">
                <dc:Bounds x="825" y="620" width="150" height="80" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_AddSelection" bpmnElement="UserTask_AddSelection">
                <dc:Bounds x="825" y="150" width="140" height="80" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_MoreQuestions" bpmnElement="Gateway_MoreQuestions"
                isMarkerVisible="true">
                <dc:Bounds x="1190" y="165" width="50" height="50" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Assemble" bpmnElement="UserTask_Assemble">
                <dc:Bounds x="1305" y="150" width="150" height="80" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_Export" bpmnElement="ServiceTask_Export">
                <dc:Bounds x="1495" y="420" width="150" height="80" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Shape_End" bpmnElement="EndEvent_End">
                <dc:Bounds x="1695" y="414" width="36" height="36" />
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="Edge_01" bpmnElement="Flow_01">
                <di:waypoint x="171" y="190" />
                <di:waypoint x="205" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_02" bpmnElement="Flow_02">
                <di:waypoint x="255" y="190" />
                <di:waypoint x="295" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_03" bpmnElement="Flow_03">
                <di:waypoint x="230" y="215" />
                <di:waypoint x="230" y="660" />
                <di:waypoint x="295" y="660" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_04" bpmnElement="Flow_04">
                <di:waypoint x="435" y="190" />
                <di:waypoint x="485" y="190" />
                <di:waypoint x="485" y="410" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_05" bpmnElement="Flow_05">
                <di:waypoint x="445" y="660" />
                <di:waypoint x="485" y="660" />
                <di:waypoint x="485" y="460" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_06" bpmnElement="Flow_06">
                <di:waypoint x="510" y="435" />
                <di:waypoint x="525" y="435" />
                <di:waypoint x="525" y="190" />
                <di:waypoint x="545" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10">
                <di:waypoint x="690" y="190" />
                <di:waypoint x="710" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11">
                <di:waypoint x="760" y="190" />
                <di:waypoint x="825" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_12" bpmnElement="Flow_12">
                <di:waypoint x="735" y="215" />
                <di:waypoint x="735" y="275" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_13" bpmnElement="Flow_13">
                <di:waypoint x="760" y="300" />
                <di:waypoint x="825" y="300" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_14" bpmnElement="Flow_14">
                <di:waypoint x="735" y="325" />
                <di:waypoint x="735" y="660" />
                <di:waypoint x="825" y="660" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_15" bpmnElement="Flow_15">
                <di:waypoint x="710" y="300" />
                <di:waypoint x="710" y="245" />
                <di:waypoint x="265" y="245" />
                <di:waypoint x="265" y="190" />
                <di:waypoint x="205" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_16" bpmnElement="Flow_16">
                <di:waypoint x="975" y="300" />
                <di:waypoint x="1025" y="300" />
                <di:waypoint x="1025" y="490" />
                <di:waypoint x="535" y="490" />
                <di:waypoint x="535" y="435" />
                <di:waypoint x="510" y="435" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_17" bpmnElement="Flow_17">
                <di:waypoint x="975" y="660" />
                <di:waypoint x="975" y="735" />
                <di:waypoint x="455" y="735" />
                <di:waypoint x="455" y="435" />
                <di:waypoint x="460" y="435" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_18" bpmnElement="Flow_18">
                <di:waypoint x="965" y="190" />
                <di:waypoint x="1190" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_19" bpmnElement="Flow_19">
                <di:waypoint x="1215" y="165" />
                <di:waypoint x="1215" y="85" />
                <di:waypoint x="230" y="85" />
                <di:waypoint x="230" y="165" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_20" bpmnElement="Flow_20">
                <di:waypoint x="1240" y="190" />
                <di:waypoint x="1305" y="190" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_21" bpmnElement="Flow_21">
                <di:waypoint x="1455" y="190" />
                <di:waypoint x="1475" y="190" />
                <di:waypoint x="1475" y="435" />
                <di:waypoint x="1495" y="435" />
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Edge_22" bpmnElement="Flow_22">
                <di:waypoint x="1645" y="460" />
                <di:waypoint x="1695" y="460" />
                <di:waypoint x="1695" y="432" />
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>